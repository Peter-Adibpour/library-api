# Storage backend: "database" (PostgreSQL) or "memory" (in-memory lists)

STORAGE_BACKEND=database

# Local PostgreSQL connection string (replace with your local credentials)

DATABASE_URL=postgresql+psycopg://postgres:your_local_password@localhost:5432/library

# Classroom Bearer tokens for role-based access control (safe demo values)

MEMBER_TOKEN=student-member-token
ADMIN_TOKEN=instructor-admin-token